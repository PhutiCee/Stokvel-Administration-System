# Copy to server/.env for a NEW installation. Keep existing server/.env values
# when updating an installation; add only the recovery settings below.
DATABASE_URL=postgresql://postgres:password@localhost:5432/stokvel
DATABASE_SSL=false
PORT=4000
NODE_ENV=development
# For a hosted PostgreSQL service, use its connection string and SSL settings.

# Password reset email delivery (Brevo HTTPS API). Leave unset to disable email recovery.
# Create a Brevo API key and verify your email under Senders.
# MAIL_FROM is a plain address; put the display name in MAIL_FROM_NAME.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Stokvel Ledger

# Must match the deployed web app origin; used to build one-time reset links.
WEB_ORIGIN=http://localhost:3000
