{
  "name": "@sas/server",
  "version": "0.1.0",
  "private": true,
  "description": "Stokvel Administration System — application tier (Node.js, Express, PostgreSQL)",
  "main": "src/index.js",
  "engines": { "node": ">=18.17" },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/db/migrate.js up",
    "migrate:status": "node src/db/migrate.js status",
    "migrate:reset": "node src/db/migrate.js reset",
    "seed": "node src/db/seed.js",
    "db:rebuild": "npm run migrate:reset && npm run seed",
    "test": "node --test tests/"
  },
  "dependencies": {
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "pg": "8.12.0"
  }
}